diff --git a/src/d_iwad.c b/src/d_iwad.c
index 5b6db20..1495ff3 100644
--- a/src/d_iwad.c
+++ b/src/d_iwad.c
@@ -745,6 +745,23 @@ static void BuildIWADDirList(void)
     // be different from the current directory.
     AddIWADDir(M_DirName(myargv[0]));
 
+#ifdef __vexa__
+    // In a Vexa app bundle (Doom.vxapp/Contents/Vexa/chocolate-doom), the
+    // game's files are in Contents/Resources. (Started as chocolate-doom at
+    // a shell, through the link to it in /bin, the bundle is where the link
+    // leads.)
+    {
+        char *program = realpath("/proc/self/exe", NULL);
+
+        if (program != NULL)
+        {
+            AddIWADDir(M_StringJoin(M_DirName(program), DIR_SEPARATOR_S, "..",
+                                    DIR_SEPARATOR_S, "Resources", NULL));
+            free(program);
+        }
+    }
+#endif
+
     // Add DOOMWADDIR if it is in the environment
     env = M_getenv("DOOMWADDIR");
     if (env != NULL)
