+// Vexa's libc++ has no iostreams (no localization), and cbindgen's normalizer header
+// includes <ostream>. The header only needs the stream names, so a copy with <iosfwd>
+// is enough (the same rewrite the standalone build makes).
+fn vexa_normalizer_include(include: &str) -> String {
+    let out = PathBuf::from(env::var("OUT_DIR").unwrap()).join("vexa-normalizer-include");
+    fs::create_dir_all(&out).unwrap();
+    let text = fs::read_to_string(Path::new(include).join("normalizer_glue.h")).unwrap();
+    fs::write(out.join("normalizer_glue.h"), text.replace("#include <ostream>", "#include <iosfwd>")).unwrap();
+    out.to_str().unwrap().to_string()
+}
