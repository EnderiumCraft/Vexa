Mesa 24.0.5 for native Vexa programs (tools/build-mesa-vexa.sh): Vexa as an
OS (DETECT_OS_VEXA, a Unix: sysconf for memory and processors), no siginfo
signal handler for the HUD, and libOSMesa.so as its soname.

--- a/src/util/detect_os.h
+++ b/src/util/detect_os.h
@@ -20,6 +20,11 @@
 #define DETECT_OS_UNIX 1
 #endif
 
+#if defined(__vexa__)
+#define DETECT_OS_VEXA 1
+#define DETECT_OS_UNIX 1
+#endif
+
 /*
  * Android defines __linux__, so DETECT_OS_LINUX and DETECT_OS_UNIX will
  * also be defined.
@@ -114,6 +119,10 @@
 #ifndef DETECT_OS_HURD
 #define DETECT_OS_HURD 0
 #endif
+#ifndef DETECT_OS_VEXA
+#define DETECT_OS_VEXA 0
+#endif
+
 #ifndef DETECT_OS_LINUX
 #define DETECT_OS_LINUX 0
 #endif
--- a/src/util/os_misc.c
+++ b/src/util/os_misc.c
@@ -57,7 +57,7 @@
 #  include <unistd.h>
 #  include <log/log.h>
 #  include <cutils/properties.h>
-#elif DETECT_OS_LINUX || DETECT_OS_CYGWIN || DETECT_OS_SOLARIS || DETECT_OS_HURD || DETECT_OS_MANAGARM
+#elif DETECT_OS_LINUX || DETECT_OS_CYGWIN || DETECT_OS_SOLARIS || DETECT_OS_HURD || DETECT_OS_MANAGARM || DETECT_OS_VEXA
 #  include <unistd.h>
 #elif DETECT_OS_OPENBSD || DETECT_OS_FREEBSD
 #  include <sys/resource.h>
@@ -266,7 +266,7 @@
 bool
 os_get_total_physical_memory(uint64_t *size)
 {
-#if DETECT_OS_LINUX || DETECT_OS_CYGWIN || DETECT_OS_SOLARIS || DETECT_OS_HURD || DETECT_OS_MANAGARM
+#if DETECT_OS_LINUX || DETECT_OS_CYGWIN || DETECT_OS_SOLARIS || DETECT_OS_HURD || DETECT_OS_MANAGARM || DETECT_OS_VEXA
    const long phys_pages = sysconf(_SC_PHYS_PAGES);
    const long page_size = sysconf(_SC_PAGE_SIZE);
 
--- a/src/gallium/auxiliary/hud/hud_context.c
+++ b/src/gallium/auxiliary/hud/hud_context.c
@@ -79,7 +79,7 @@
 static int hud_rotate = HUD_DEFAULT_ROTATION;
 static float hud_opacity = HUD_DEFAULT_OPACITY / 100.0f;
 
-#if DETECT_OS_UNIX
+#if DETECT_OS_UNIX && !DETECT_OS_VEXA /* (Vexa: no siginfo handlers.) */
 static void
 signal_visible_handler(int sig, siginfo_t *siginfo, void *context)
 {
@@ -1942,7 +1942,7 @@
    }
    const char *env = debug_get_option("GALLIUM_HUD",
       emulate_libgl_show_fps ? "stdout,fps" : NULL);
-#if DETECT_OS_UNIX
+#if DETECT_OS_UNIX && !DETECT_OS_VEXA /* (Vexa: no siginfo handlers.) */
    unsigned signo = debug_get_num_option("GALLIUM_HUD_TOGGLE_SIGNAL", 0);
    static bool sig_handled = false;
    struct sigaction action;
@@ -2033,7 +2033,7 @@
    list_inithead(&hud->pane_list);
 
    /* setup sig handler once for all hud contexts */
-#if DETECT_OS_UNIX
+#if DETECT_OS_UNIX && !DETECT_OS_VEXA /* (Vexa: no siginfo handlers.) */
    if (!sig_handled && signo != 0) {
       action.sa_sigaction = &signal_visible_handler;
       action.sa_flags = SA_SIGINFO;
--- a/src/gallium/targets/osmesa/meson.build
+++ b/src/gallium/targets/osmesa/meson.build
@@ -32,6 +32,11 @@
   osmesa_link_deps += files('osmesa.sym')
 endif
 
+if host_machine.system() == 'vexa'
+  # (Vexa: one name, libOSMesa.so, whether a program links it or SDL loads it.)
+  osmesa_link_args += ['-Wl,-soname,libOSMesa.so']
+endif
+
 osmesa_def = custom_target(
   'osmesa.def',
   input: 'osmesa.def.in',
