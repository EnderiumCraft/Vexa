+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "virgl/drm/virgl_drm_public.h"
+
+/* Vexa: the host's GPU through the virtio GPU (virgl), when there's one,
+ * unless VEXA_GL=softpipe asks for software. */
+static struct pipe_screen *
+virgl_screen_create(void)
+{
+   const char *choice = getenv("VEXA_GL");
+   if (choice && strcmp(choice, "softpipe") == 0)
+      return NULL;
+   int fd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return NULL;
+   struct pipe_screen *screen = virgl_drm_screen_create(fd, NULL);
+   close(fd); /* (The screen keeps its own copy.) */
+   return screen;
+}
+#endif
+
 
