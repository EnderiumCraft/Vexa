// A small <sstream> for building LLVM for Vexa (tools/build-llvm-vexa.sh).
//
// The SDK's libc++ has no locales, so no iostreams. A few of LLVM's files build short strings
// with std::stringstream (debug output, error messages): this is enough of it for them, on
// std::string. Numbers are formatted with snprintf; std::setw and std::hex/std::dec work.
#ifndef VEXA_LLVM_SSTREAM
#define VEXA_LLVM_SSTREAM

#include <cstdio>
#include <string>
#include <string_view>
#include <type_traits>
#include <iosfwd>

// libc++ declares basic_stringstream and basic_ostringstream (and the stringstream aliases)
// even without locales, but never defines them: the char versions are defined here, inside
// libc++'s own namespace, on a small shared base.
_LIBCPP_BEGIN_NAMESPACE_STD

struct __vexa_setw {
    int width;
};
inline __vexa_setw setw(int width) {
    return {width};
}

class __vexa_stream_base;
using __vexa_manip = __vexa_stream_base &(*)(__vexa_stream_base &);

class __vexa_stream_base {
public:
    __vexa_stream_base() = default;
    explicit __vexa_stream_base(const string &initial) : buffer_(initial) {}

    string str() const {
        return buffer_;
    }
    void str(const string &text) {
        buffer_ = text;
    }

    __vexa_stream_base &operator<<(__vexa_manip manip) {
        return manip(*this);
    }
    __vexa_stream_base &operator<<(__vexa_setw w) {
        width_ = w.width;
        return *this;
    }
    __vexa_stream_base &operator<<(const char *text) {
        return put(text ? string_view(text) : string_view("(null)"));
    }
    __vexa_stream_base &operator<<(const string &text) {
        return put(text);
    }
    __vexa_stream_base &operator<<(string_view text) {
        return put(text);
    }
    __vexa_stream_base &operator<<(char c) {
        return put(string_view(&c, 1));
    }
    __vexa_stream_base &operator<<(bool b) {
        return put(b ? "1" : "0");
    }
    __vexa_stream_base &operator<<(const void *p) {
        char text[32];
        snprintf(text, sizeof(text), "%p", p);
        return put(text);
    }
    template <typename T, enable_if_t<is_integral_v<T> && !is_same_v<T, char> &&
                                          !is_same_v<T, bool>, int> = 0>
    __vexa_stream_base &operator<<(T value) {
        char text[32];
        if (hex_) {
            snprintf(text, sizeof(text), "%llx", (unsigned long long)value);
        } else if (is_signed_v<T>) {
            snprintf(text, sizeof(text), "%lld", (long long)value);
        } else {
            snprintf(text, sizeof(text), "%llu", (unsigned long long)value);
        }
        return put(text);
    }
    template <typename T, enable_if_t<is_floating_point_v<T>, int> = 0>
    __vexa_stream_base &operator<<(T value) {
        char text[64];
        snprintf(text, sizeof(text), "%g", (double)value);
        return put(text);
    }
    // Anything that converts to a string (llvm::StringRef, say).
    template <typename T, enable_if_t<!is_arithmetic_v<T> && !is_pointer_v<T> &&
                                          is_convertible_v<const T &, string>, int> = 0>
    __vexa_stream_base &operator<<(const T &value) {
        return put(string(value));
    }

    void set_hex(bool hex) {
        hex_ = hex;
    }

private:
    __vexa_stream_base &put(string_view text) {
        if (width_ > 0 && text.size() < (size_t)width_) {
            buffer_.append(width_ - text.size(), ' ');
        }
        width_ = 0;
        buffer_.append(text);
        return *this;
    }

    string buffer_;
    int width_ = 0;
    bool hex_ = false;
};

inline __vexa_stream_base &hex(__vexa_stream_base &s) {
    s.set_hex(true);
    return s;
}
inline __vexa_stream_base &dec(__vexa_stream_base &s) {
    s.set_hex(false);
    return s;
}

template <>
class basic_stringstream<char, char_traits<char>, allocator<char>> : public __vexa_stream_base {
public:
    using __vexa_stream_base::__vexa_stream_base;
};
template <>
class basic_ostringstream<char, char_traits<char>, allocator<char>> : public __vexa_stream_base {
public:
    using __vexa_stream_base::__vexa_stream_base;
};

_LIBCPP_END_NAMESPACE_STD

#endif
