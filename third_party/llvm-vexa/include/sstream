// A small <sstream> for building LLVM for Vexa (tools/build-llvm-vexa.sh).
//
// The SDK's libc++ has no locales, so no iostreams. A few of LLVM's files build short strings
// with std::stringstream (debug output, error messages): this is enough of it for them, on
// std::string. Numbers are formatted with snprintf; std::setw and std::hex/std::dec work.
#ifndef VEXA_LLVM_SSTREAM
#define VEXA_LLVM_SSTREAM

#include <cstdio>
#include <string>
#include <string_view>
#include <type_traits>

namespace std {

class __vexa_stringstream;
using __vexa_manip = __vexa_stringstream &(*)(__vexa_stringstream &);

struct __vexa_setw {
    int width;
};
inline __vexa_setw setw(int width) {
    return {width};
}

class __vexa_stringstream {
public:
    __vexa_stringstream() = default;
    explicit __vexa_stringstream(const string &initial) : buffer_(initial) {}

    string str() const {
        return buffer_;
    }
    void str(const string &text) {
        buffer_ = text;
    }

    __vexa_stringstream &operator<<(__vexa_manip manip) {
        return manip(*this);
    }
    __vexa_stringstream &operator<<(__vexa_setw w) {
        width_ = w.width;
        return *this;
    }
    __vexa_stringstream &operator<<(const char *text) {
        return put(text ? string_view(text) : string_view("(null)"));
    }
    __vexa_stringstream &operator<<(const string &text) {
        return put(text);
    }
    __vexa_stringstream &operator<<(string_view text) {
        return put(text);
    }
    __vexa_stringstream &operator<<(char c) {
        return put(string_view(&c, 1));
    }
    __vexa_stringstream &operator<<(bool b) {
        return put(b ? "1" : "0");
    }
    __vexa_stringstream &operator<<(const void *p) {
        char text[32];
        snprintf(text, sizeof(text), "%p", p);
        return put(text);
    }
    template <typename T, enable_if_t<is_integral_v<T> && !is_same_v<T, char> &&
                                          !is_same_v<T, bool>, int> = 0>
    __vexa_stringstream &operator<<(T value) {
        char text[32];
        if (hex_) {
            snprintf(text, sizeof(text), "%llx", (unsigned long long)value);
        } else if (is_signed_v<T>) {
            snprintf(text, sizeof(text), "%lld", (long long)value);
        } else {
            snprintf(text, sizeof(text), "%llu", (unsigned long long)value);
        }
        return put(text);
    }
    template <typename T, enable_if_t<is_floating_point_v<T>, int> = 0>
    __vexa_stringstream &operator<<(T value) {
        char text[64];
        snprintf(text, sizeof(text), "%g", (double)value);
        return put(text);
    }
    // Anything that converts to a string (llvm::StringRef, say).
    template <typename T, enable_if_t<!is_arithmetic_v<T> && !is_pointer_v<T> &&
                                          is_convertible_v<const T &, string>, int> = 0>
    __vexa_stringstream &operator<<(const T &value) {
        return put(string(value));
    }

    void set_hex(bool hex) {
        hex_ = hex;
    }

private:
    __vexa_stringstream &put(string_view text) {
        if (width_ > 0 && text.size() < (size_t)width_) {
            buffer_.append(width_ - text.size(), ' ');
        }
        width_ = 0;
        buffer_.append(text);
        return *this;
    }

    string buffer_;
    int width_ = 0;
    bool hex_ = false;
};

inline __vexa_stringstream &hex(__vexa_stringstream &s) {
    s.set_hex(true);
    return s;
}
inline __vexa_stringstream &dec(__vexa_stringstream &s) {
    s.set_hex(false);
    return s;
}

using stringstream = __vexa_stringstream;
using ostringstream = __vexa_stringstream;

} // namespace std

#endif
