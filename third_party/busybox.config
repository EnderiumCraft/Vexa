# Vexa's changes to BusyBox's default configuration (`make defconfig`).
# tools/configure-busybox.sh applies them; see the busybox targets in the Makefile.

# One static program, with no dynamic loader needed (that's Phase 6).
CONFIG_STATIC=y
# CONFIG_PIE is not set

# The shell runs applets straight from the busybox binary instead of looking
# for /bin/ls and friends, which don't exist as links (Vexa has no symbolic
# links yet, and its own /bin has native programs of the same names).
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_BUSYBOX_EXEC_PATH="/linux/bin/busybox"

# Line editing without asking the terminal where the cursor is.
# CONFIG_FEATURE_EDITING_ASK_TERMINAL is not set

# Traffic control doesn't build against current kernel headers, and has no use here.
# CONFIG_TC is not set
