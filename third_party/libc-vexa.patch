+/// getpwuid_r over libvexa's getpwuid: the record and its strings are copied into `buf`.
+pub unsafe fn getpwuid_r(
+    uid: uid_t,
+    pwd: *mut passwd,
+    buf: *mut c_char,
+    buflen: size_t,
+    result: *mut *mut passwd,
+) -> c_int {
+    *result = core::ptr::null_mut();
+    let found = getpwuid(uid);
+    if found.is_null() {
+        return 0;
+    }
+    let fields = [(*found).pw_name, (*found).pw_passwd, (*found).pw_gecos, (*found).pw_dir, (*found).pw_shell];
+    let mut total = 0;
+    let mut i = 0;
+    while i < fields.len() {
+        total += strlen(fields[i]) + 1;
+        i += 1;
+    }
+    if total > buflen {
+        return ERANGE;
+    }
+    let mut at = buf;
+    let mut copied = [core::ptr::null_mut::<c_char>(); 5];
+    let mut i = 0;
+    while i < fields.len() {
+        let n = strlen(fields[i]) + 1;
+        core::ptr::copy_nonoverlapping(fields[i], at, n);
+        copied[i] = at;
+        at = at.add(n);
+        i += 1;
+    }
+    (*pwd).pw_name = copied[0];
+    (*pwd).pw_passwd = copied[1];
+    (*pwd).pw_uid = (*found).pw_uid;
+    (*pwd).pw_gid = (*found).pw_gid;
+    (*pwd).pw_gecos = copied[2];
+    (*pwd).pw_dir = copied[3];
+    (*pwd).pw_shell = copied[4];
+    *result = pwd;
+    0
+}
