+// Calls libc declares that libvexa doesn't have (yet). Vectored I/O is done as a loop over
+// read and write; the times calls report ENOSYS; ioctl has no implementation here, so
+// programs that call it fail to link until libvexa provides it.
+extern "C" {
+    pub fn ioctl(fd: c_int, request: c_ulong, ...) -> c_int;
+    pub fn pthread_create(
+        thread: *mut pthread_t,
+        attr: *const pthread_attr_t,
+        start: extern "C" fn(*mut c_void) -> *mut c_void,
+        arg: *mut c_void,
+    ) -> c_int;
+}
+
+pub unsafe fn writev(fd: c_int, iov: *const iovec, iovcnt: c_int) -> ssize_t {
+    let mut total: ssize_t = 0;
+    for i in 0..iovcnt as isize {
+        let v = *iov.offset(i);
+        let n = write(fd, v.iov_base, v.iov_len);
+        if n < 0 {
+            return if total > 0 { total } else { n };
+        }
+        total += n;
+        if (n as size_t) < v.iov_len {
+            break;
+        }
+    }
+    total
+}
+
+pub unsafe fn readv(fd: c_int, iov: *const iovec, iovcnt: c_int) -> ssize_t {
+    let mut total: ssize_t = 0;
+    for i in 0..iovcnt as isize {
+        let v = *iov.offset(i);
+        let n = read(fd, v.iov_base, v.iov_len);
+        if n < 0 {
+            return if total > 0 { total } else { n };
+        }
+        total += n;
+        if (n as size_t) < v.iov_len {
+            break;
+        }
+    }
+    total
+}
+
+unsafe fn enosys() -> c_int {
+    *__errno_location() = ENOSYS;
+    -1
+}
+
+pub unsafe fn futimens(_fd: c_int, _times: *const timespec) -> c_int {
+    enosys()
+}
+
+pub unsafe fn utimensat(_dirfd: c_int, _path: *const c_char, _times: *const timespec, _flags: c_int) -> c_int {
+    enosys()
+}
