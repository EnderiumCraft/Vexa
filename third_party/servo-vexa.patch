diff -ruN a/servo-fonts-0.7.0/platform/freetype/vexa/font_list.rs b/servo-fonts-0.7.0/platform/freetype/vexa/font_list.rs
--- a/servo-fonts-0.7.0/platform/freetype/vexa/font_list.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/servo-fonts-0.7.0/platform/freetype/vexa/font_list.rs	2026-10-12 11:14:47.765225249 +0000
@@ -0,0 +1,151 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! The font list on Vexa. The fonts are the TrueType and OpenType files in `/share/fonts`,
+//! the directory libvexa's text reads from, and FreeType reads each file for its family and
+//! style. There is no fontconfig here, so the only fonts are the ones in that directory: the
+//! DejaVu faces that Vexa ships.
+
+use std::ffi::{CStr, CString};
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use fonts_traits::{FontTemplate, FontTemplateDescriptor, LocalFontIdentifier};
+use freetype_sys::{FT_Done_Face, FT_Face, FT_New_Face};
+use style::Atom;
+use style::values::computed::font::GenericFontFamily;
+use style::values::computed::{FontStyle, FontWeight, FontWidth};
+
+use crate::platform::freetype::library_handle::FreeTypeLibraryHandle;
+use crate::{FallbackFontSelectionOptions, FontIdentifier, LowercaseFontFamilyName};
+
+const FONT_DIRECTORY: &str = "/share/fonts";
+
+/// FreeType's style flags for a face.
+const STYLE_FLAG_ITALIC: i64 = 1;
+const STYLE_FLAG_BOLD: i64 = 2;
+
+/// The family name and style of a font file's first face.
+struct FaceInfo {
+    family: String,
+    bold: bool,
+    italic: bool,
+}
+
+/// The TrueType and OpenType files in the font directory, in name order.
+fn font_files() -> Vec<PathBuf> {
+    let Ok(entries) = fs::read_dir(FONT_DIRECTORY) else {
+        return Vec::new();
+    };
+    let mut files: Vec<PathBuf> = entries
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|path| {
+            path.extension()
+                .and_then(|extension| extension.to_str())
+                .is_some_and(|extension| {
+                    matches!(extension.to_ascii_lowercase().as_str(), "ttf" | "otf")
+                })
+        })
+        .collect();
+    files.sort();
+    files
+}
+
+/// Reads the family name and the style of a font file's first face, with FreeType.
+fn face_info(path: &Path) -> Option<FaceInfo> {
+    let c_path = CString::new(path.to_str()?).ok()?;
+    let library = FreeTypeLibraryHandle::get().lock();
+    let mut face: FT_Face = std::ptr::null_mut();
+    let error = unsafe { FT_New_Face(library.freetype_library, c_path.as_ptr(), 0, &mut face) };
+    if error != 0 || face.is_null() {
+        return None;
+    }
+    let info = unsafe {
+        let face_record = &*face;
+        if face_record.family_name.is_null() {
+            None
+        } else {
+            CStr::from_ptr(face_record.family_name)
+                .to_str()
+                .ok()
+                .map(|family| FaceInfo {
+                    family: family.to_owned(),
+                    bold: face_record.style_flags as i64 & STYLE_FLAG_BOLD != 0,
+                    italic: face_record.style_flags as i64 & STYLE_FLAG_ITALIC != 0,
+                })
+        }
+    };
+    unsafe { FT_Done_Face(face) };
+    info
+}
+
+pub(crate) fn for_each_available_family<F>(mut callback: F)
+where
+    F: FnMut(String),
+{
+    for path in font_files() {
+        if let Some(info) = face_info(&path) {
+            callback(info.family);
+        }
+    }
+}
+
+pub(crate) fn for_each_variation<F>(family_name: &str, mut callback: F)
+where
+    F: FnMut(FontTemplate),
+{
+    for path in font_files() {
+        let Some(info) = face_info(&path) else {
+            continue;
+        };
+        if !info.family.eq_ignore_ascii_case(family_name) {
+            continue;
+        }
+        let Some(path) = path.to_str() else {
+            continue;
+        };
+        let weight = if info.bold {
+            FontWeight::from_float(700.)
+        } else {
+            FontWeight::normal()
+        };
+        let style = if info.italic {
+            FontStyle::ITALIC
+        } else {
+            FontStyle::NORMAL
+        };
+        let identifier = LocalFontIdentifier {
+            path: Atom::from(path),
+            face_index: 0,
+            named_instance_index: 0,
+        };
+        callback(FontTemplate::new(
+            FontIdentifier::Local(identifier),
+            FontTemplateDescriptor::new(weight, FontWidth::NORMAL, style),
+            None,
+        ));
+    }
+}
+
+/// The families to try for a character no font of the page has: the sans family, which covers
+/// the characters DejaVu has.
+pub fn fallback_font_families(_options: FallbackFontSelectionOptions) -> Vec<&'static str> {
+    vec!["DejaVu Sans"]
+}
+
+pub(crate) fn default_system_generic_font_family(
+    generic: GenericFontFamily,
+) -> LowercaseFontFamilyName {
+    let name = match generic {
+        GenericFontFamily::Monospace => "DejaVu Sans Mono",
+        // Vexa ships no serif face, so serif text uses the sans family.
+        GenericFontFamily::None |
+        GenericFontFamily::Serif |
+        GenericFontFamily::SansSerif |
+        GenericFontFamily::SystemUi |
+        GenericFontFamily::Cursive |
+        GenericFontFamily::Fantasy => "DejaVu Sans",
+    };
+    name.into()
+}
